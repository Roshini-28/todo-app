# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGO_CONNECTION_STRING=your_mongodb_connection_string
DATABASE_NAME=todo_db

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ===========================================
# AI PROVIDER CONFIGURATION
# ===========================================
DEFAULT_AI_PROVIDER=gemini
ENABLE_FALLBACK=false
FALLBACK_PROVIDER=nvidia

# Provider 1: OLLAMA CLOUD (Cloud-hosted, not local)
# Get API key from Ollama Cloud dashboard
OLLAMA_CLOUD_MODEL=your_ollama_cloud_model
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key
OLLAMA_CLOUD_BASE_URL=https://your-ollama-cloud-endpoint.com

# Provider 2: NVIDIA CLOUD
# Get API key from https://build.nvidia.com/
NVIDIA_MODEL=your_nvidia_model
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Provider 3: GOOGLE GEMINI CLOUD
# Get API key from https://aistudio.google.com/
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
